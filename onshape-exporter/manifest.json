{
  "manifest_version": 3,
  "name": "Onshape Part Exporter",
  "version": "0.6.0",
  "description": "Unofficial: export Onshape Part Studio parts (3MF, STEP, STL…) and open them in Bambu Studio, OrcaSlicer, PrusaSlicer or Cura.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "downloads",
    "storage"
  ],
  "key": "",
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "settings.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "onshape-exporter@globiii.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
